{{/* Build proceedings pages directly from the yearly JSON data. */}}
{{ range $key, $config := hugo.Data }}
  {{ if findRE `^proceedings_[0-9]{4}$` $key }}
  {{ $year := string ($config.year | default (strings.TrimPrefix "proceedings_" $key)) }}
  {{ $data := $config.records }}
  {{ $.AddPage (dict
    "kind" "section"
    "path" $year
    "title" $config.title
    "layout" "year"
    "params" (dict "year" $year)
  ) }}
  {{ $.AddPage (dict
    "kind" "page"
    "path" (printf "%s/authors" $year)
    "title" "Author Index"
    "layout" "authors"
    "params" (dict "year" $year)
  ) }}
  {{ range $index, $record := $data }}
    {{ $talk := strings.TrimSpace (string ($record.talk_id | default "")) }}
    {{ if $talk }}
      {{ $.AddPage (dict
        "kind" "page"
        "path" (printf "%s/papers/%s" $year $talk)
        "title" (($record.title_ja | default $record.title_en | default $talk) | plainify)
        "layout" "paper"
        "params" (dict "year" $year "talk_id" $talk "position" (add $index 1) "paper" $record)
      ) }}
    {{ end }}
  {{ end }}
{{ end }}
{{ end }}
